# Cloakroom settings. start.sh / start.ps1 copies this file to .env on first run.
# Edit .env (not this file), then run: cloakroom start

# Optional. Free key (sign in with GitHub): https://cloakbrowser.dev/free
# Leave blank to use the free binary that ships inside the image.
CLOAKBROWSER_LICENSE_KEY=

# Optional. Send all browser traffic through a proxy.
# Examples: http://user:pass@host:8080   socks5://host:1080
CLOAKROOM_PROXY=

# Optional. Any number or word (letters, digits, - and _) to choose the browser
# fingerprint. Left blank, Cloakroom picks one on first start and keeps it with
# the saved profile, so the fingerprint survives restarts either way.
CLOAKROOM_FINGERPRINT_SEED=

# Change these only if something else on your computer already uses the port.
CLOAKROOM_CDP_PORT=9222
CLOAKROOM_VIEWER_PORT=6080

# The container's clock. Leave this commented to use this computer's timezone.
# The browser itself reports the timezone and locale of the IP its traffic
# leaves from (GeoIP), so a proxy gets its own exit's clock.
# TZ=America/Chicago

# Optional. The model behind `cloakroom chat`; it must accept images.
CLOAKROOM_MODEL=deepseek/deepseek-v4.1-flash

# Change this only if something else on your computer already uses the port.
CLOAKROOM_API_PORT=8423
