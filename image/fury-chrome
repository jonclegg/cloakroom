#!/usr/bin/env python3
"""Launch the Fury core the way cloakserve launches CloakBrowser's binary.

cloakserve runs the browser pool, GeoIP and native input, and starts the browser
with CloakBrowser's flags: --fingerprint=<seed>, --fingerprint-platform,
--fingerprint-timezone, --lang and so on. CLOAKBROWSER_BINARY_PATH points it
here instead. This turns those flags into a Fury persona config, hands the
config to the core on descriptor 3 (--fury-fp-fd=3), and execs the core in this
process, so cloakserve's handle on it stays valid.

The persona is a real machine from Fury's catalogue (fury-personas.json, made by
`cargo run -p fury-shared --example catalogue` in jonclegg/fury-antidetect-browser).
It is chosen among those whose screen is the container's Xvfb display, so the
screen a page measures is the one the window is really on, and the seed picks
among them, so a profile keeps its machine across restarts.
"""

import ipaddress
import json
import os
import re
import subprocess
import sys
import tempfile

import geoip2.database
from cloakbrowser.geoip import _ensure_geoip_db

CORE = "/opt/fury/chrome"
PERSONAS = "/opt/fury/personas.json"
# What Fury's catalogue persona does not carry and a real Mac reports: WebGL2
# limits, shader precision, the WebGL2 extension list and the voice list,
# measured from Chrome on an Apple Silicon Mac. Without them the container's
# software renderer and empty voice list show through (read by patches 0034, 0042).
MAC_MEASURED = "/opt/fury/mac-measured.json"
# Chrome's current stable build, which the persona claims in place of the core's
# own. The core is built from 155.0.8059.12, a beta every Fury build reports;
# Akamai blocks that exact version (measured on LoopNet: blocked as .12, passes
# as any other build). Bump it when Chrome stable moves on.
STABLE_FULL_VERSION = "155.0.8059.39"
# WebGL extensions the measured Mac lists that SwiftShader cannot back: listed,
# getExtension() would return null for them, which Akamai checks (it asks for
# pvrtc by name).
UNBACKED_WEBGL_EXTENSIONS = {"WEBGL_compressed_texture_astc", "WEBGL_compressed_texture_etc", "WEBGL_compressed_texture_etc1",
                             "WEBGL_compressed_texture_pvrtc", "WEBGL_render_shared_exponent"}
MASK64 = (1 << 64) - 1
OPENBOX_SYSTEM_CONFIG = "/etc/xdg/openbox/rc.xml"
OPENBOX_CONFIG = "/root/.config/openbox/rc.xml"


def flag_values(argv):
    values = {}
    for arg in argv:
        if arg.startswith("--") and "=" in arg:
            name, value = arg[2:].split("=", 1)
            values[name] = value
    return values


# Fury's sub-seed, from shared-rs/src/persona.rs (mix, sub_seed), so a profile
# gets the same noise here as it would from Fury's own agent.
def mix(z):
    z = (z + 0x9E3779B97F4A7C15) & MASK64
    z = ((z ^ (z >> 30)) * 0xBF58476D1CE4E5B9) & MASK64
    z = ((z ^ (z >> 27)) * 0x94D049BB133111EB) & MASK64
    return z ^ (z >> 31)


def sub_seed(seed, purpose):
    h = seed
    for byte in purpose.encode():
        h = mix(h ^ byte)
    return mix(h) & 0x7FFFFFFF


def choose_persona(platform, seed):
    width, height = (int(n) for n in os.environ.get("CLOAKBROWSER_DISPLAY_SIZE", "1920x1080").split("x"))
    wanted_os = {"macos": "macOS", "windows": "Windows"}[platform]
    with open(PERSONAS) as f:
        personas = json.load(f)
    matching = [
        p for p in personas
        if p["os"] == wanted_os
        and round(p["screen"]["width"] * p["screen"]["devicePixelRatio"]) == width
        and round(p["screen"]["height"] * p["screen"]["devicePixelRatio"]) == height
    ]
    if not matching:
        raise SystemExit(f"fury-chrome: no {wanted_os} persona has a {width}x{height} screen; "
                         f"set CLOAKBROWSER_DISPLAY_SIZE to one that a catalogue persona has")
    # Weighted by how common the machine is, as Fury's own pick is.
    point = (mix(seed) % 1_000_000) / 1_000_000 * sum(p["weight"] for p in matching)
    for persona in matching:
        point -= persona["weight"]
        if point < 0:
            return persona
    return matching[-1]


def image_font_families():
    """Families the image's own font packages installed, under /usr/share/fonts.

    These are the Linux ones (Liberation, WenQuanYi, ...) that neither persona's
    machine has; a Mac host's own fonts are mounted under /usr/local/share/fonts.
    Measured: Liberation Sans rendered in a macOS profile without this.
    """
    listing = subprocess.run(["fc-list", "--format", "%{file}\t%{family}\n"],
                             capture_output=True, text=True, check=True).stdout
    families = set()
    for line in listing.splitlines():
        path, names = line.split("\t", 1)
        if path.startswith("/usr/share/fonts/"):
            families.update(name.strip() for name in names.split(","))
    return families


# Chrome's default fonts per generic family, as Chrome on a Mac has them. Linux
# Chrome takes cursive and fantasy from its own defaults (Comic Sans MS, Impact)
# rather than fontconfig, so mac-fonts.conf cannot reach them. Measured against
# Chrome 154 on macOS with the same fonts: cursive is Apple Chancery, fantasy
# Papyrus.
MAC_DEFAULT_FONTS = {"standard": "Times", "serif": "Times", "sansserif": "Helvetica",
                     "fixed": "Menlo", "cursive": "Apple Chancery", "fantasy": "Papyrus"}


def set_default_fonts(user_data_dir, fonts):
    """Merge Chrome's default-font preferences into the profile before it starts."""
    path = os.path.join(user_data_dir, "Default", "Preferences")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    preferences = {}
    if os.path.exists(path):
        with open(path) as f:
            preferences = json.load(f)
    webprefs = preferences.setdefault("webkit", {}).setdefault("webprefs", {}).setdefault("fonts", {})
    for family, font in fonts.items():
        webprefs[family] = {"Zyyy": font}
    with open(path, "w") as f:
        json.dump(preferences, f)


def reserve_persona_desktop(screen):
    """Give openbox the persona's menu bar and Dock (or taskbar) as screen margins.

    The window is then started maximized, which fills exactly the persona's
    available area. Maximized is the only state in which Linux Chrome draws no
    frame of its own: un-maximized it keeps a 4 px border, so the page started
    4 px right of window.screenX while the persona reports outerWidth ==
    innerWidth, and every mouse event's screenX disagreed with its window.
    Measured: events at +4, window at 0. cloakserve's /input treats a maximized
    window as borderless too, so clicks land where they are aimed.
    """
    dpr = screen["devicePixelRatio"]
    margins = {
        "top": screen["availTop"],
        "left": screen["availLeft"],
        "bottom": screen["height"] - screen["availTop"] - screen["availHeight"],
        "right": screen["width"] - screen["availLeft"] - screen["availWidth"],
    }
    block = "<margins>" + "".join(f"<{side}>{round(value * dpr)}</{side}>" for side, value in margins.items()) + "</margins>"
    with open(OPENBOX_SYSTEM_CONFIG) as f:
        config = f.read()
    config, count = re.subn(r"<margins>.*?</margins>", block, config, flags=re.S)
    assert count == 1, "openbox rc.xml has no <margins> block"
    os.makedirs(os.path.dirname(OPENBOX_CONFIG), exist_ok=True)
    with open(OPENBOX_CONFIG, "w") as f:
        f.write(config)
    subprocess.run(["openbox", "--reconfigure"], check=True)


def languages_for(locale):
    language = locale.split("-")[0]
    if language == "en":
        return [locale, "en"] if locale != "en" else ["en-US", "en"]
    return [locale, language, "en-US", "en"]


def geolocation_for(ip):
    with geoip2.database.Reader(str(_ensure_geoip_db())) as reader:
        location = reader.city(ip).location
    return {"latitude": location.latitude, "longitude": location.longitude, "accuracy": 20000.0}


def main():
    argv = sys.argv[1:]
    flags = flag_values(argv)
    seed = int(flags["fingerprint"])
    platform = flags.get("fingerprint-platform", "windows")
    timezone = flags["fingerprint-timezone"]
    locale = flags["lang"]

    persona = choose_persona(platform, seed)
    config = persona["config"]
    config["locale"] = {"timezone": timezone, "locale": locale}
    config["navigator"]["languages"] = languages_for(locale)
    # No clientRects noise: it moves element boxes off the 1/64 px grid every real
    # Chrome layout lands on (measured: 224.9845 against Chrome's 224.9844).
    config["noise"] = {purpose + "Seed": sub_seed(seed, purpose)
                       for purpose in ("canvas", "audio")}
    config["noise"]["deviceIdSalt"] = sub_seed(seed, "deviceId")
    config["fontsHidden"] = sorted(set(config["fontsHidden"]) | image_font_families())
    # Fury's derivation writes [], and Chrome on a desktop answers ["Desktop"]:
    # measured against CloakBrowser's Chrome 146 on the same page.
    config["clientHints"]["formFactors"] = ["Desktop"]
    core_version = config["clientHints"]["fullVersion"]
    config["clientHints"]["fullVersion"] = STABLE_FULL_VERSION
    config["clientHints"]["fullVersionList"] = [entry.replace(core_version, STABLE_FULL_VERSION)
                                                for entry in config["clientHints"]["fullVersionList"]]
    exit_ip = flags.get("fingerprint-webrtc-ip")
    if exit_ip and not ipaddress.ip_address(exit_ip).is_private:
        config["geolocation"] = geolocation_for(exit_ip)

    if platform == "macos":
        set_default_fonts(flags["user-data-dir"], MAC_DEFAULT_FONTS)
        with open(MAC_MEASURED) as f:
            measured = json.load(f)
        config["gpu"].update(measured["gpu"])
        config.setdefault("speech", {}).update(measured["speech"])
    # Only the Mac measurements carry a WebGL2 list; a Windows persona has one list.
    for key in ("webglExtensions", "webgl2Extensions"):
        if key in config["gpu"]:
            config["gpu"][key] = [name for name in config["gpu"][key] if name not in UNBACKED_WEBGL_EXTENSIONS]

    print(f"fury-chrome: persona {persona['id']}, seed {seed}, {timezone}, {locale}", file=sys.stderr)

    # Read to EOF by the core; unlinked so nothing else can open it.
    with tempfile.NamedTemporaryFile("w", delete=False, dir="/tmp", prefix="fury-config-") as f:
        json.dump(config, f)
    fd = os.open(f.name, os.O_RDONLY)
    os.unlink(f.name)
    # cloakserve starts this with only 0-2 open, so the open above is usually
    # descriptor 3 already, and dup2 onto itself keeps Python's close-on-exec.
    os.dup2(fd, 3)
    os.set_inheritable(3, True)

    reserve_persona_desktop(config["screen"])
    # Linux Chromium leaves out APIs that Chrome on a Mac or Windows PC has, and a
    # Mac user agent without them is a Linux machine to anyone who looks.
    # Measured in the container: no navigator.share, canShare or bluetooth, no
    # WebGPU adapter, no media devices. Each comes back with its switch.
    features = ["Vulkan", "WebShare", "WebBluetooth"]
    # JPEG XL puts image/jxl in every Accept header, which no Chrome release sends.
    disabled_features = ["JXLImageFormat"]
    args = []
    for arg in argv:
        if arg.startswith("--fingerprint"):
            continue
        if arg.startswith("--enable-features="):
            features += arg.split("=", 1)[1].split(",")
            continue
        if arg.startswith("--disable-features="):
            disabled_features += arg.split("=", 1)[1].split(",")
            continue
        args.append(arg)
    args += [
        f"--enable-features={','.join(features)}",
        f"--disable-features={','.join(disabled_features)}",
        # SwiftShader-backed 2D canvas spends ~300 ms on a page's first draw and
        # toDataURL (measured; 2 ms in software), and Akamai times exactly that.
        "--disable-accelerated-2d-canvas",
        "--enable-unsafe-webgpu",
        "--use-vulkan=swiftshader",
        # One microphone, one speaker and one camera, as a laptop has. Labels stay
        # empty until a site is granted the permission, as they are on Chrome.
        "--use-fake-device-for-media-stream",
        "--fury-fp-fd=3",
        # Fills the persona's available area: under the menu bar and above the
        # Dock on a Mac, above the taskbar on Windows (reserve_persona_desktop).
        "--start-maximized",
        # No GPU in the container: WebGL and WebGPU come from SwiftShader, which
        # Chromium no longer falls back to on its own.
        "--enable-unsafe-swiftshader",
        # cloakserve passes --no-sandbox (the container runs as root), and
        # Chromium answers it with an "unsupported command-line flag" bar that
        # shrinks the page. --test-type is the switch that suppresses that bar.
        "--test-type",
        # What Fury's agent passes: field-trial testing config force-enables
        # features real stable Chrome ships disabled (launcher.rs).
        "--disable-field-trial-config",
    ]
    os.execv(CORE, [CORE, *args])


if __name__ == "__main__":
    main()
