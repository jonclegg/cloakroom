#!/bin/bash
set -euo pipefail
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir="$(cd "$(dirname "$source")" && pwd)"
  source="$(readlink "$source")"
  case "$source" in
    /*) ;;
    *) source="$dir/$source" ;;
  esac
done
root="$(cd "$(dirname "$source")" && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  echo "Cloakroom needs python3. On a Mac run: xcode-select --install" >&2
  exit 1
fi

export PYTHONPATH="$root/cli"
exec python3 -m cloakroom_cli "$@"
