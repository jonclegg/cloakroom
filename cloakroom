#!/bin/bash
set -euo pipefail
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir="$(cd "$(dirname "$source")" && pwd)"
  source="$(readlink "$source")"
  case "$source" in
    /*) ;;
    *) source="$dir/$source" ;;
  esac
done
source "$(cd "$(dirname "$source")" && pwd)/lib.sh"

usage() {
  cat >&2 <<EOF
Usage: cloakroom <command> [--json]

  start          Start the stealth browser.
  stop           Stop it (the profile is kept).
  status         Is it ready, and the viewer, CDP, and share URLs.
  share          Private HTTPS link to the viewer. No confirmation.
  unshare        Stop that link.
  chat "<msg>"   Talk to Cloakroom; it works the browser with DeepSeek and
                 replies. --session <id> continues the same tab and conversation.
  run <id>       A run's steps, reply, and saved files.
  cancel <id>    Stop a run.
  notes [site]   What Cloakroom has learned about each site.
  key            Open a page to paste the OpenRouter key into (never into chat).
                 --in-browser opens it in Cloakroom's browser, for the viewer.
  smoke [sites]  Reach a few big sites from Bing and open a report with
                 screenshots (default: amazon walmart target bestbuy).

chat, run, cancel, notes, key and smoke run inside the container, so from any
shell (PowerShell too) they also work as: docker exec cloakroom cloakroom <command>
EOF
  exit 2
}

status() {
  docker_running=false
  docker info >/dev/null 2>&1 && docker_running=true
  container="$(health)"
  browser=""
  [ "$container" = healthy ] && browser="$(curl -fsS --max-time 10 "${CDP_URL}/json/version" | sed -n 's/.*"Browser": *"\([^"]*\)".*/\1/p')"
  share_url="$(active_share_url)"
  openrouter_key=false
  [ -s "${DATA_DIR}/openrouter.key" ] && openrouter_key=true
  if [ "${1:-}" = --json ]; then
    printf '{"docker_running":%s,"container":"%s","ready":%s,"browser":%s,"cdp_url":"%s","viewer_url":"%s","api_url":"%s","openrouter_key":%s,"share_url":%s}\n' \
      "$docker_running" "$container" "$([ "$container" = healthy ] && echo true || echo false)" \
      "$([ -n "$browser" ] && echo "\"$browser\"" || echo null)" "$CDP_URL" "$VIEWER_URL" "$API_URL" "$openrouter_key" \
      "$([ -n "$share_url" ] && echo "\"$share_url\"" || echo null)"
    return 0
  else
    printf 'Docker running:    %s\nContainer:         %s\nBrowser:           %s\nViewer:            %s\nShare:             %s\nCDP:               %s\nChat API:          %s\nOpenRouter key:    %s\n' \
      "$docker_running" "$container" "${browser:--}" "$VIEWER_URL" "${share_url:--}" "$CDP_URL" "$API_URL" \
      "$([ "$openrouter_key" = true ] && echo set || echo "missing (run: cloakroom key)")"
  fi
  [ "$container" = healthy ]
}

require_running() {
  if [ "$(health)" != healthy ]; then
    echo "Cloakroom is not running. Start it with: cloakroom start" >&2
    exit 1
  fi
}

open_on_host() {
  case "$(uname -s)" in
    Darwin) open "$1" ;;
    *) command -v xdg-open >/dev/null 2>&1 && xdg-open "$1" >/dev/null 2>&1 ;;
  esac
}

command="${1:-}"
[ $# -gt 0 ] && shift
case "$command" in
  start) exec bash "${CLOAKROOM_ROOT}/start.sh" ;;
  stop) exec bash "${CLOAKROOM_ROOT}/stop.sh" ;;
  status) status "$@" ;;
  share) exec bash "${CLOAKROOM_ROOT}/share.sh" "$@" ;;
  unshare) exec bash "${CLOAKROOM_ROOT}/share.sh" stop "$@" ;;
  key)
    require_running
    if [ "${1:-}" = --json ] || [ "${1:-}" = --in-browser ]; then
      exec docker exec cloakroom cloakroom key "$@"
    fi
    link="$(docker exec cloakroom cloakroom key --json)"
    url="$(printf '%s' "$link" | sed -n 's/.*"setup_url": *"\([^"]*\)".*/\1/p')"
    open_on_host "$url" || true
    echo "Paste the OpenRouter key into: ${url}"
    echo "The link works once and lasts 15 minutes."
    ;;
  smoke)
    require_running
    if [ "${1:-}" = --json ]; then
      exec docker exec cloakroom cloakroom smoke "$@"
    fi
    result=0
    docker exec cloakroom cloakroom smoke "$@" || result=$?
    report="$(ls -td "${DATA_DIR}"/smoke/smoke_* 2>/dev/null | head -n 1)/report.html"
    [ -f "$report" ] && { open_on_host "$report" || true; }
    exit "$result"
    ;;
  chat|run|cancel|notes)
    require_running
    exec docker exec cloakroom cloakroom "$command" "$@"
    ;;
  *) usage ;;
esac
